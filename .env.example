# Kafka & Schema Registry
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_MODE=share
SHARE_GROUP_TRIAGE=sg-triage-workers

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_ACTIVE_ALIAS=kb_chunks_active
EMBEDDING_MODEL=all-minilm:22m
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSIONS=384

# AI Provider: "ollama" (default, zero API key), "local" (deterministic CPU), or "openai" (hosted)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:0.5b

# Hosted Provider Override (used only when AI_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Resilience & Governance
LLM_TIMEOUT_SECONDS=18.0
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=0.75
LLM_BACKOFF_MAX_SECONDS=8.0
LLM_RATE_LIMIT_RPS=8.0
AUDIT_RETENTION_DAYS=2555

# File Watcher
WATCH_DIR=./watched_kb
WATCH_POLL_SECONDS=0.5
