{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeadLetterEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dlq_id",
    "source_topic",
    "source_partition",
    "source_offset",
    "message_key",
    "worker_stage",
    "error_type",
    "error_message",
    "retry_attempts",
    "raw_payload_b64",
    "failed_ts_ms"
  ],
  "properties": {
    "dlq_id": { "type": "string", "minLength": 1 },
    "source_topic": { "type": "string" },
    "source_partition": { "type": "integer" },
    "source_offset": { "type": "integer" },
    "message_key": { "type": ["string", "null"] },
    "worker_stage": { "type": "string" },
    "error_type": { "type": "string" },
    "error_message": { "type": "string" },
    "retry_attempts": { "type": "integer", "minimum": 0 },
    "raw_payload_b64": { "type": "string" },
    "failed_ts_ms": { "type": "integer", "minimum": 0 }
  }
}
