{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportAgentToolCallEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "call_id",
    "ticket_id",
    "requested_by_agent",
    "tool_name",
    "arguments",
    "total_calls_for_ticket",
    "created_ts_ms"
  ],
  "properties": {
    "call_id": { "type": "string", "minLength": 1 },
    "ticket_id": { "type": "string", "minLength": 1 },
    "requested_by_agent": { "type": "string" },
    "tool_name": { "type": "string", "enum": ["kb_search", "account_sla_lookup", "billing_ledger_check"] },
    "arguments": { "type": "object" },
    "total_calls_for_ticket": { "type": "integer", "minimum": 1 },
    "created_ts_ms": { "type": "integer", "minimum": 0 }
  }
}
