{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SupportAgentToolResultEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "call_id",
    "ticket_id",
    "tool_name",
    "status",
    "output",
    "citations",
    "total_calls_for_ticket",
    "latency_ms",
    "completed_ts_ms"
  ],
  "properties": {
    "call_id": { "type": "string", "minLength": 1 },
    "ticket_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "error"] },
    "output": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "chunk_id", "title", "score", "embedding_version"],
        "properties": {
          "doc_id": { "type": "string" },
          "chunk_id": { "type": "string" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "score": { "type": "number" },
          "embedding_model": { "type": "string" },
          "embedding_version": { "type": "string" }
        }
      }
    },
    "total_calls_for_ticket": { "type": "integer", "minimum": 1 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "completed_ts_ms": { "type": "integer", "minimum": 0 }
  }
}
